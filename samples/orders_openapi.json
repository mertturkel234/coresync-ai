{
  "openapi": "3.0.3",
  "info": {
    "title": "Acme Orders Demo API",
    "version": "1.2.0",
    "description": "Synthetic B2B Orders API used by the CoreSync AI controlled sandbox."
  },
  "servers": [
    {
      "url": "https://sandbox.coresync.local/demo"
    }
  ],
  "security": [
    {
      "SandboxKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "SandboxKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Sandbox-Key",
        "description": "Scoped expiring sandbox credential (csk_<id>_<secret>)."
      }
    },
    "schemas": {
      "OrderCreate": {
        "type": "object",
        "required": ["customer_ref", "currency", "items"],
        "properties": {
          "customer_ref": {
            "type": "string",
            "example": "cust_acme_42",
            "description": "External customer reference."
          },
          "currency": {
            "type": "string",
            "enum": ["USD", "EUR", "GBP"],
            "example": "USD"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "required": ["sku", "quantity", "unit_cents"],
        "properties": {
          "sku": {
            "type": "string",
            "example": "SKU-PRO-PLAN"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          },
          "unit_cents": {
            "type": "integer",
            "minimum": 0,
            "example": 4900
          }
        }
      },
      "Order": {
        "type": "object",
        "required": ["id", "status", "customer_ref", "currency", "total_cents"],
        "properties": {
          "id": {
            "type": "string",
            "example": "ord_1001"
          },
          "status": {
            "type": "string",
            "enum": ["created", "confirmed", "cancelled"]
          },
          "customer_ref": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "total_cents": {
            "type": "integer"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/demo/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List orders",
        "description": "Returns synthetic orders in the sandbox environment, optionally filtered by status.",
        "tags": ["orders"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["created", "confirmed", "cancelled"]
            },
            "description": "Filter orders by lifecycle status."
          }
        ],
        "responses": {
          "200": {
            "description": "List of orders.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orders": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or revoked X-Sandbox-Key header."
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "summary": "Create an order",
        "description": "Creates a new synthetic order and calculates total_cents from line items.",
        "tags": ["orders"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created order.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or revoked X-Sandbox-Key header."
          },
          "422": {
            "description": "Invalid order payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/demo/orders/{order_id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Get an order by ID",
        "description": "Fetches a single synthetic order by its identifier (for example ord_1001).",
        "tags": ["orders"],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "ord_1001"
            },
            "description": "Order identifier."
          }
        ],
        "responses": {
          "200": {
            "description": "Order details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "description": "Order not found."
          }
        }
      }
    }
  }
}
