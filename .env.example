# CoreSync AI — example environment. Copy to `.env` and edit. NEVER commit `.env`.
# All values below are placeholders / local-development defaults only.

ENVIRONMENT=development

# --- Database (docker compose provides this PostgreSQL service) ---
POSTGRES_USER=coresync
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=coresync
DATABASE_URL=postgresql+psycopg://coresync:change-me-local-only@localhost:5432/coresync

# --- Redis (optional locally; used for rate limiting). Leave empty to use in-memory limits. ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (>= 32 chars, not a placeholder) when ENVIRONMENT=production.
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=./.data/storage

# --- LLM provider (server-side only). Default 'offline' needs no credentials. ---
LLM_PROVIDER=offline
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Optional dev tool (docker compose --profile tools up) ---
PGADMIN_DEFAULT_EMAIL=dev@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local-only
